{
    "name": "ember-high-contrast",
    "displayName": "Ember High Contrast",
    "description": "A dark, high-contrast color theme with 8 accent color variants",
    "version": "0.2.0",
    "publisher": "danielhdzzz",
    "repository": {
        "type": "git",
        "url": "https://github.com/danielhdzzz/vscode-ember-high-contrast"
    },
    "homepage": "https://github.com/danielhdzzz/vscode-ember-high-contrast",
    "engines": {
        "vscode": "^1.28.0"
    },
    "keywords": [
        "theme",
        "dark",
        "high-contrast",
        "color-theme"
    ],
    "categories": [
        "Themes"
    ],
    "galleryBanner": {
        "color": "#1e1e1e",
        "theme": "dark"
    },
    "icon": "icon.png",
    "contributes": {
        "themes": [
            {
                "label": "Ember High Contrast (orange)",
                "uiTheme": "vs-dark",
                "path": "./themes/ember-high-contrast-orange.json"
            },
            {
                "label": "Ember High Contrast (gray)",
                "uiTheme": "vs-dark",
                "path": "./themes/ember-high-contrast-gray.json"
            },
            {
                "label": "Ember High Contrast (purple)",
                "uiTheme": "vs-dark",
                "path": "./themes/ember-high-contrast-purple.json"
            },
            {
                "label": "Ember High Contrast (red)",
                "uiTheme": "vs-dark",
                "path": "./themes/ember-high-contrast-red.json"
            },
            {
                "label": "Ember High Contrast (yellow)",
                "uiTheme": "vs-dark",
                "path": "./themes/ember-high-contrast-yellow.json"
            },
            {
                "label": "Ember High Contrast (green)",
                "uiTheme": "vs-dark",
                "path": "./themes/ember-high-contrast-green.json"
            },
            {
                "label": "Ember High Contrast (blue)",
                "uiTheme": "vs-dark",
                "path": "./themes/ember-high-contrast-blue.json"
            },
            {
                "label": "Ember High Contrast (white)",
                "uiTheme": "vs-dark",
                "path": "./themes/ember-high-contrast-white.json"
            }
        ]
    },
    "devDependencies": {
        "prettier": "^2.3.0",
        "@vscode/vsce": "^3.1.0"
    }
}
